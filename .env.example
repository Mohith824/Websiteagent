# Anthropic Claude API Key (Get yours from: https://console.anthropic.com/)
# Replace the placeholder below in your actual .env file (DO NOT commit your actual key)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database path (defaults to local SQLite inside data/)
DATABASE_URL=sqlite:///./data/admissions.db
